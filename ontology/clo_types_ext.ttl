    clo:implementsBaseKind clo:AIJobKind ;
    clo:hostedBy clo:AWS ;
    clo:labelingSupport "full" ;
    rdfs:comment "Extension type (bedrock:model-invocation-job). Evidence: 45 of 45 recorded resources carry tags (E+)."@en .

